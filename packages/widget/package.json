{
  "name": "@lean-harness/widget",
  "version": "0.1.0",
  "description": "<lean-chat>: a drop-in chat web component for any lean-harness server. Works in any page or framework.",
  "license": "MIT",
  "author": "Kevin Solomon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikevinsolomon/lean-harness.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/ikevinsolomon/lean-harness#readme",
  "bugs": {
    "url": "https://github.com/ikevinsolomon/lean-harness/issues"
  },
  "keywords": [
    "ai",
    "chat",
    "web-component",
    "lit",
    "widget",
    "llm"
  ],
  "sideEffects": [
    "./dist/lean-chat.js",
    "./dist/lib/lean-chat.js",
    "./src/lean-chat.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/lean-chat.ts",
    "./client": "./src/client.ts",
    "./dist/lean-chat.js": "./dist/lean-chat.js"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/lib/lean-chat.d.ts",
        "default": "./dist/lib/lean-chat.js"
      },
      "./client": {
        "types": "./dist/lib/client.d.ts",
        "default": "./dist/lib/client.js"
      },
      "./dist/lean-chat.js": "./dist/lean-chat.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lit": "^3.3.3",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
