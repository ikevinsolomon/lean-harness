{
  "name": "@lean-harness/server",
  "version": "0.1.0",
  "description": "HTTP + Server-Sent Events API for a lean-harness agent, so any UI can drive it.",
  "license": "MIT",
  "author": "Kevin Solomon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikevinsolomon/lean-harness.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/ikevinsolomon/lean-harness#readme",
  "bugs": {
    "url": "https://github.com/ikevinsolomon/lean-harness/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "harness",
    "llm",
    "api",
    "sse",
    "hono"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@lean-harness/core": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13"
  }
}
