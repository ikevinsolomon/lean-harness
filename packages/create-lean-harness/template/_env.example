# Copy to .env and add at least one model key. Each key turns its provider on.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: the model new chats start with, as provider/model.
DEFAULT_MODEL=

# Optional: give Claude web search and a code sandbox (run by Anthropic, billed per use).
CLAUDE_WEB_SEARCH=
CLAUDE_CODE_EXECUTION=

# Sign-in: the first visitor creates the admin account; others join by invite link.
# AUTH=off turns sign-in off (a single-user app on your own machine).
AUTH=

# Optional: Postgres instead of the SQLite file in .data/ (also run `npm install pg`).
DATABASE_URL=

# Optional: the address people use to reach the app (https://chat.example.com). Links in emails,
# Google/Microsoft sign-in and `reset-password` use it. Default: http://localhost:PORT.
PUBLIC_URL=

# Optional: send email (invites, "Forgot password?", sign-up and confirmation links).
# Resend (resend.com), or any SMTP server (also run `npm install nodemailer`), or EMAIL=console
# to print emails in this terminal while trying things out. EMAIL_FROM must be an address
# your provider lets you send from, e.g. "Support Desk <help@example.com>".
RESEND_API_KEY=
SMTP_URL=
EMAIL=
EMAIL_FROM=

# Optional: who may sign up without an invite, until an admin changes it in People.
# SIGNUP=invite (default), domain (anyone with an email at SIGNUP_DOMAINS), or open.
# Sign-up needs email or a sign-in provider below, so people prove their address.
SIGNUP=
SIGNUP_DOMAINS=

# Optional: "Continue with Google / Microsoft / your provider". Register the redirect URL
# PUBLIC_URL/v1/auth/sso/<google|microsoft|oidc>/callback with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your directory (tenant) ID to allow only your organization; empty allows any Microsoft account.
MICROSOFT_TENANT=
# Any OpenID Connect provider (Okta, Auth0, Keycloak...): its issuer URL, and the button name.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# Optional: behind a proxy or load balancer you run, set to 1 so sign-in limits and the
# activity log see visitors' real IP addresses (from X-Forwarded-For).
TRUST_PROXY=

PORT=8787
