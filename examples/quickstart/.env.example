# Copy to .env and fill in the providers you want. Each key turns its provider on.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: which models each provider offers (comma-separated). Leave empty to ask the provider.
OPENAI_MODELS=
GEMINI_MODELS=
OPENROUTER_MODELS=

# Optional: set to 1 to give Claude web search and a code sandbox (run by Anthropic, billed per use).
CLAUDE_WEB_SEARCH=
CLAUDE_CODE_EXECUTION=

# Optional: the model new chats start with, as provider/model. Defaults to Claude, then DeepSeek, then the mock model.
DEFAULT_MODEL=

# Optional: set to 1 to keep the offline mock model in the menu even when a provider is connected.
MOCK_MODEL=

# Sign-in. By default people sign in with email and password: the first visitor creates the
# admin account, and everyone else joins by an invite link (People, in the sidebar), or signs
# up if you allow it (below).
# AUTH=off turns sign-in off (a single-user app on your own machine).
AUTH=

# Optional, instead of accounts: fixed access tokens, id:token pairs, comma-separated.
# Use long random tokens, e.g. from `openssl rand -hex 24`.
HARNESS_USERS=

# Optional, single-user: require "Authorization: Bearer <key>" on the API.
HARNESS_API_KEY=

# Optional: where chats, memory and accounts are kept. DATABASE_URL (Postgres) wins over
# DATABASE_FILE (SQLite, the default: .data/lean-harness.db).
DATABASE_URL=
DATABASE_FILE=

# Optional: the address people use to reach the app (https://chat.example.com). Links in emails,
# Google/Microsoft sign-in and `reset-password` use it. Default: http://localhost:PORT.
PUBLIC_URL=

# Optional: send email (invites, "Forgot password?", sign-up and confirmation links).
# Resend (resend.com), or any SMTP server (also run `npm install nodemailer`), or EMAIL=console
# to print emails in this terminal while trying things out. EMAIL_FROM must be an address
# your provider lets you send from, e.g. "Support Desk <help@example.com>".
RESEND_API_KEY=
SMTP_URL=
EMAIL=
EMAIL_FROM=

# Optional: who may sign up without an invite, until an admin changes it in People.
# SIGNUP=invite (default), domain (anyone with an email at SIGNUP_DOMAINS), or open.
# Sign-up needs email or a sign-in provider below, so people prove their address.
SIGNUP=
SIGNUP_DOMAINS=

# Optional: "Continue with Google / Microsoft / your provider". Register the redirect URL
# PUBLIC_URL/v1/auth/sso/<google|microsoft|oidc>/callback with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your directory (tenant) ID to allow only your organization; empty allows any Microsoft account.
MICROSOFT_TENANT=
# Any OpenID Connect provider (Okta, Auth0, Keycloak...): its issuer URL, and the button name.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# Optional: behind a proxy or load balancer you run, set to 1 so sign-in limits and the
# activity log see visitors' real IP addresses (from X-Forwarded-For).
TRUST_PROXY=

# Optional: limit messages per user per minute, and the site allowed to call the API from a browser.
RATE_LIMIT_PER_MINUTE=
CORS_ORIGIN=

PORT=8787
