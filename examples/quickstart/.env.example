# Copy to .env and fill in the providers you want. Each key turns its provider on.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: which models each provider offers (comma-separated). Leave empty to ask the provider.
OPENAI_MODELS=
GEMINI_MODELS=
OPENROUTER_MODELS=

# Optional: the model new chats start with, as provider/model. Defaults to Claude, then DeepSeek, then the mock model.
DEFAULT_MODEL=

# Optional: set to 1 to keep the offline mock model in the menu even when a provider is connected.
MOCK_MODEL=

# Optional: sign-in. Each person gets their own chats and memory: id:token pairs, comma-separated.
# Use long random tokens, e.g. from `openssl rand -hex 24`.
HARNESS_USERS=

# Optional, single-user: require "Authorization: Bearer <key>" on the API.
HARNESS_API_KEY=

# Optional: where chats are kept. DATABASE_URL (Postgres) wins over DATABASE_FILE (SQLite, the default).
DATABASE_URL=
DATABASE_FILE=

# Optional: limit messages per user per minute, and the site allowed to call the API from a browser.
RATE_LIMIT_PER_MINUTE=
CORS_ORIGIN=

PORT=8787
